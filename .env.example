# Local development only. Copy to .env and choose your own database password.
POSTGRES_PASSWORD=
AGENT_ENABLED=false
# Optional: set these only when using GitHub projects or Signals Agent.
GITHUB_API_TOKEN=
GEMINI_API_KEY=
AGENT_INTERNAL_KEY=
# Embeddings for the evidence index: gemini (needs GEMINI_API_KEY) or local (CPU, no key).
# local models must produce at least 768 dimensions, e.g. BAAI/bge-base-en-v1.5 or Qwen/Qwen3-Embedding-0.6B.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

{$DEMO_DOMAIN} {
  # Access log for the owner's own visit summaries (IP, path, referrer, user agent).
  # Rolled at 20 MiB and deleted after 30 days.
  log {
    output file /data/access/signals.log {
      roll_size 20MiB
      roll_keep 10
      roll_keep_for 720h
    }
  }

  # Compression can hold back server-sent events, so the streamed Agent answer is sent uncompressed.
  @compressible not path /api/agent/ask/stream
  encode @compressible zstd gzip
  header {
    X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"
  }

  @blockedWrites {
    method POST PUT PATCH DELETE
    path /api/*
    not path /api/github/projects/resolve /api/agent/ask /api/agent/ask/stream
  }

  route {
    respond @blockedWrites "Read-only public demo" 403
    handle /api/* {
      reverse_proxy backend:8080
    }
    handle {
      reverse_proxy frontend:3000
    }
  }
}

# Other sites on this host (for example the Vision demo) live in deploy/sites/*.caddy on the server.
# CI never ships or overwrites that directory, so a Signals deploy cannot drop them. No match is fine.
import /etc/caddy/sites/*.caddy

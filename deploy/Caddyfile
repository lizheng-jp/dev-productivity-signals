{$DEMO_DOMAIN} {
  encode zstd gzip
  header {
    X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"
  }

  @blockedWrites {
    method POST PUT PATCH DELETE
    path /api/*
    not path /api/github/projects/resolve /api/agent/ask
  }

  route {
    respond @blockedWrites "Read-only public demo" 403
    handle /api/* {
      reverse_proxy backend:8080
    }
    handle {
      reverse_proxy frontend:3000
    }
  }
}
